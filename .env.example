# Database (SQLite for local dev; use Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Session signing secret (min 32 chars). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# First admin bootstrap (used by `npm run admin:bootstrap`)
ADMIN_EMAIL="admin@geartech.jo"
ADMIN_PASSWORD="change-me-strong-password"

# AI concierge (optional — deterministic engine runs without these)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Storage (optional — local uploads used in dev)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
